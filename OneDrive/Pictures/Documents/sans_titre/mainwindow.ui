  <property name="styleSheet">
   <string notr="true">
/* Main Window Background */
QMainWindow {
    background-color: #FAF5F0;
}

/* Sidebar Styling */
#sidebar {
    background-color: #8D6E63;
    border-right: none;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
}

#sidebarTitle {
    color: #FFFFFF;
    font-family: 'Times New Roman', serif;
    font-size: 18px;
    font-weight: bold;
    padding: 10px;
}

#sidebarIcon {
    color: #FFFFFF;
    font-size: 32px;
    background-color: transparent;
    border: none;
}

/* Main Content Area */
#contentArea {
    background-color: #FAF5F0;
}

#moduleTitle {
    color: #291C0E;
    font-family: 'Times New Roman', serif;
    font-size: 22px;
    font-weight: bold;
}

/* Table Styling */
#employeeTable {
    background-color: #FFFFFF;
    alternate-background-color: #FFF8F0;
    border: none;
    border-radius: 12px;
    gridline-color: #F0E6DA;
    font-family: Arial, sans-serif;
    font-size: 11px;
    selection-background-color: #8D6E63;
    selection-color: white;
}

#employeeTable::item {
    padding: 12px 8px;
    border: none;
    border-bottom: 1px solid #F0E6DA;
    color: #291C0E;
    background-color: transparent;
}

#employeeTable::item:alternate {
    background-color: #FFF8F0;
}

#employeeTable::item:selected {
    background-color: #8D6E63;
    color: white;
}

#employeeTable::item:hover {
    background-color: #F5EDE3;
}

QHeaderView::section {
    background-color: #8D6E63;
    color: white;
    padding: 14px 10px;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:last {
    border-right: none;
}

QHeaderView {
    background-color: transparent;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QHeaderView::section:horizontal:first {
    border-top-left-radius: 12px;
}

QHeaderView::section:horizontal:last {
    border-top-right-radius: 12px;
}

QScrollBar:vertical {
    border: none;
    background-color: #F5F5F5;
    width: 10px;
    border-radius: 5px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #BCAAA4;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A78D78;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background-color: #F5F5F5;
    height: 10px;
    border-radius: 5px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #BCAAA4;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #A78D78;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Profile Panel */
#profilePanel {
    background-color: #E7DDD1;
    border: 2px solid #BCAAA4;
    border-radius: 10px;
}

#profileTitle {
    color: #291C0E;
    font-family: 'Times New Roman', serif;
    font-size: 16px;
    font-weight: bold;
}

#profileLabel, #profileLabel_2, #profileLabel_3, #profileLabel_4, #profileLabel_5, 
#profileLabel_6, #profileLabel_7, #profileLabel_8, #profileLabel_9, #profileLabel_10,
#profileLabel_11, #profileLabel_12, #profileLabel_13 {
    color: #291C0E;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: bold;
}

#profileValue, #profileValue_2, #profileValue_3, #profileValue_4, #profileValue_5,
#profileValue_6, #profileValue_7, #profileValue_8, #profileValue_9, #profileValue_10,
#profileValue_11, #profileValue_12, #profileValue_13 {
    color: #291C0E;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: bold;
}

/* Photo Placeholder */
#photoPlaceholder {
    background-color: #FFF8F0;
    border: 2px solid #BCAAA4;
    border-radius: 8px;
}

/* Primary Action Buttons */
QPushButton#btnAdd, QPushButton#btnEdit, QPushButton#btnDelete, QPushButton#btnExport {
    background-color: #8D6E63;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: bold;
    text-align: center;
}

QPushButton#btnAdd:hover, QPushButton#btnEdit:hover, QPushButton#btnDelete:hover, QPushButton#btnExport:hover {
    background-color: #A0826D;
    border: none;
}

QPushButton#btnAdd:pressed, QPushButton#btnEdit:pressed, QPushButton#btnDelete:pressed, QPushButton#btnExport:pressed {
    background-color: #6E473B;
    border: none;
    padding: 11px 20px 9px 20px;
}

/* Search Box */
#searchBox {
    background-color: white;
    color: #291C0E;
    border: 2px solid #A78D78;
    border-radius: 6px;
    padding: 8px;
    font-family: Arial, sans-serif;
    font-size: 11px;
}

#searchBox::placeholder {
    color: #A78D78;
}

/* Separator Lines */
QFrame#separator {
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
}

/* Navigation Buttons */
QPushButton#btnEmployees, QPushButton#btnClients, QPushButton#btnProducts, 
QPushButton#btnOrders, QPushButton#btnRawMaterials, QPushButton#btnSuppliers {
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 8px;
    text-align: left;
    padding-left: 15px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin: 2px 8px;
    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#btnEmployees:hover, QPushButton#btnClients:hover, QPushButton#btnProducts:hover,
QPushButton#btnOrders:hover, QPushButton#btnRawMaterials:hover, QPushButton#btnSuppliers:hover {
    background-color: rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
    border-left: 3px solid #FFFFFF;
}

QPushButton#btnEmployees:pressed, QPushButton#btnClients:pressed, QPushButton#btnProducts:pressed,
QPushButton#btnOrders:pressed, QPushButton#btnRawMaterials:pressed, QPushButton#btnSuppliers:pressed {
    background-color: #6E473B;
    color: #FFFFFF;
}

/* Active navigation button */
QPushButton#btnEmployees {
    background-color: #6E473B;
    color: #FFFFFF;
    border-left: 3px solid #FFFFFF;
}

/* Statistics Cards */
#statsCard, #statsCard_2, #statsCard_3 {
    background-color: #FFF8F0;
    border: 1px solid #BCAAA4;
    border-radius: 8px;
}

#statsLabel, #statsLabel_2, #statsLabel_3 {
    color: #291C0E;
    font-family: Arial, sans-serif;
    font-size: 10px;
}

#statsValue, #statsValue_2, #statsValue_3 {
    color: #8D6E63;
    font-family: 'Times New Roman', serif;
    font-size: 24px;
    font-weight: bold;
}
   </string>
