   <string notr="true">
/* Main Window Background */
QMainWindow {
    background-color: #FAF5F0;
}

/* Sidebar Styling */
#sidebar {
    background-color: #8D6E63;
    border-right: none;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
}

#sidebarTitle {
    color: #FFFFFF;
    font-family: 'Times New Roman', serif;
    font-size: 18px;
    font-weight: bold;
    padding: 10px;
}

#sidebarIcon {
    color: #FFFFFF;
    font-size: 32px;
    background-color: transparent;
    border: none;
}

/* Main Content Area */
#contentArea {
    background-color: #FAF5F0;
}

#moduleTitle {
    color: #291C0E;
    font-family: 'Times New Roman', serif;
    font-size: 22px;
    font-weight: bold;
}

/* Table Styling */
#employeeTable, #clientTable, #matiereTable, #fournisseurTable, #productionTable, #articleTable {
    background-color: #FFFFFF;
    alternate-background-color: #FFF8F0;
    border: none;
    border-radius: 12px;
    gridline-color: #F0E6DA;
    font-family: Arial, sans-serif;
    font-size: 11px;
    selection-background-color: #8D6E63;
    selection-color: white;
}

#employeeTable::item, #clientTable::item, #matiereTable::item, #fournisseurTable::item, #productionTable::item, #articleTable::item {
    padding: 12px 8px;
    border: none;
    border-bottom: 1px solid #F0E6DA;
    color: #291C0E;
    background-color: transparent;
}

#employeeTable::item:alternate, #clientTable::item:alternate, #matiereTable::item:alternate, #fournisseurTable::item:alternate, #productionTable::item:alternate, #articleTable::item:alternate {
    background-color: #FFF8F0;
}

#employeeTable::item:selected, #clientTable::item:selected, #matiereTable::item:selected, #fournisseurTable::item:selected, #productionTable::item:selected, #articleTable::item:selected {
    background-color: #8D6E63;
    color: white;
}

#employeeTable::item:hover, #clientTable::item:hover, #matiereTable::item:hover, #fournisseurTable::item:hover, #productionTable::item:hover, #articleTable::item:hover {
    background-color: #F5EDE3;
}

QHeaderView::section {
    background-color: #8D6E63;
    color: white;
    padding: 14px 10px;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:last {
    border-right: none;
}

QHeaderView {
    background-color: transparent;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QHeaderView::section:horizontal:first {
    border-top-left-radius: 12px;
}

QHeaderView::section:horizontal:last {
    border-top-right-radius: 12px;
}

QScrollBar:vertical {
    border: none;
    background-color: #F5F5F5;
    width: 10px;
    border-radius: 5px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #BCAAA4;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A78D78;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background-color: #F5F5F5;
    height: 10px;
    border-radius: 5px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #BCAAA4;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #A78D78;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

