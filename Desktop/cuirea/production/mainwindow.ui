  <property name="styleSheet">
   <string notr="true">
QMainWindow { background-color: #F5F5F0; }
QWidget#centralwidget { background-color: #F5F5F0; }
QFrame#sidebarFrame { background-color: #6B5444; border: none; }
QLabel#lblAdminName { color: white; font-size: 14px; font-weight: bold; padding: 10px; }
QLabel#lblRole { color: white; font-size: 16px; font-weight: bold; padding: 5px; }
QPushButton#menuBtn { background-color: transparent; color: white; border: none; border-radius: 8px; padding: 12px 20px; font-size: 14px; text-align: left; margin: 3px 10px; }
QPushButton#menuBtn:hover { background-color: rgba(255, 255, 255, 0.1); }
QPushButton#menuBtn:pressed { background-color: rgba(255, 255, 255, 0.2); }
QPushButton#menuBtnActive { background-color: rgba(255, 255, 255, 0.15); color: white; border: none; border-left: 4px solid #D4A574; border-radius: 8px; padding: 12px 20px; font-size: 14px; text-align: left; margin: 3px 10px; font-weight: bold; }
QFrame#topFrame { background-color: white; border-radius: 15px; }
QLineEdit#searchBox { 
    background-color: #F8F8F8; 
    border: 1px solid #E0E0E0; 
    border-radius: 8px; 
    padding: 10px 15px; 
    font-size: 13px;
    color: #2C2416;
}
QLineEdit#searchBox:focus { 
    border: 2px solid #6B5444;
    background-color: white;
}
QLabel#lblTitle { color: #2C2416; font-size: 26px; font-weight: bold; padding: 15px; }
QPushButton { background-color: #6B5444; color: white; border: none; border-radius: 8px; padding: 10px 20px; font-size: 14px; font-weight: 500; }
QPushButton:hover { background-color: #7D6555; }
QPushButton:pressed { background-color: #5A4635; }
QPushButton#btnRetour { background-color: #8B7355; color: white; border: none; border-radius: 8px; padding: 10px 20px; font-size: 13px; font-weight: 500; }
QPushButton#btnRetour:hover { background-color: #9B8365; }
QFrame#statsCard { background-color: white; border: 1px solid #E0E0E0; border-radius: 12px; padding: 20px; }
QLabel#statsTitle { color: #666666; font-size: 13px; font-weight: normal; }
QLabel#statsValue { color: #5D4E37; font-size: 36px; font-weight: bold; }
QFrame#contentFrame { background-color: white; border-radius: 15px; border: 1px solid #D4C4B0; padding: 20px; }
QLabel#lblHistorique { 
    color: #2C2416; 
    font-size: 18px; 
    font-weight: bold;
    padding: 8px 0px;
    letter-spacing: 0.5px;
}
QPushButton#btnTousStatuts { 
    background-color: #F5F5F0; 
    color: #6B5444; 
    border: 1px solid #D4C4B0; 
    border-radius: 6px; 
    padding: 8px 16px; 
    font-size: 12px;
    font-weight: 500;
}
QPushButton#btnTousStatuts:hover { 
    background-color: #6B5444; 
    color: white;
    border: 1px solid #6B5444;
}
QTableWidget { 
    background-color: #FFFFFF; 
    border: none;
    border-radius: 12px; 
    gridline-color: #F5F5F5; 
    selection-background-color: rgba(107, 84, 68, 0.1);
    selection-color: #2C2416; 
    outline: none;
    alternate-background-color: #FAFAFA;
}
QTableWidget::item { 
    padding: 16px 12px; 
    border-bottom: 1px solid #F5F5F5; 
    border-left: none;
    border-right: none;
    color: #2C2416; 
    font-size: 13px;
}
QTableWidget::item:selected { 
    background-color: rgba(107, 84, 68, 0.15);
    color: #2C2416;
    font-weight: 500;
}
QTableWidget::item:hover { 
    background-color: #F8F8F8;
}
QTableWidget::item:alternate { 
    background-color: #FAFAFA; 
}
QHeaderView::section { 
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7D6555, stop:1 #6B5444);
    color: white; 
    padding: 18px 12px; 
    border: none; 
    border-right: 1px solid rgba(255, 255, 255, 0.1); 
    font-weight: bold; 
    font-size: 10px; 
    text-transform: uppercase; 
    letter-spacing: 1.5px;
}
QHeaderView::section:first {
    border-top-left-radius: 12px;
}
QHeaderView::section:last { 
    border-right: none;
    border-top-right-radius: 12px;
}
QHeaderView::section:hover { 
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #8B7355, stop:1 #7D6555);
}
QTableWidget QTableCornerButton::section { 
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7D6555, stop:1 #6B5444);
    border: none;
    border-top-left-radius: 12px;
}
QScrollBar:horizontal { 
    background-color: #F8F8F8; 
    height: 8px; 
    border-radius: 4px;
    margin: 0px 2px;
}
QScrollBar::handle:horizontal { 
    background-color: #D4C4B0; 
    border-radius: 4px; 
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { 
    background-color: #8B7355; 
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { 
    width: 0px; 
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { 
    background: none; 
}
QScrollBar:vertical { 
    background-color: #F8F8F8; 
    width: 8px; 
    border-radius: 4px;
    margin: 2px 0px;
}
QScrollBar::handle:vertical { 
    background-color: #C0B5A8; 
    border-radius: 5px; 
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { 
    background-color: #8B7355; 
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { 
    height: 0px; 
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { 
    background: none; 
}
   </string>
